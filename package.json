{
  "name": "immersive-portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/release-check.mjs preflight",
    "build": "next build --webpack",
    "postbuild": "node scripts/release-check.mjs artifacts",
    "build:preflight": "node scripts/release-check.mjs preflight",
    "build:validate-artifacts": "node scripts/release-check.mjs artifacts",
    "build:diagnostic:default": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:bug",
    "test:release-build": "node --test test/release-build.test.mjs",
    "test:bug": "node test/bug-condition/run-all.mjs",
    "test:bug:unit": "node --test test/bug-condition/unit.test.mjs",
    "test:bug:property": "node --test test/bug-condition/property.test.mjs",
    "test:bug:browser": "node test/bug-condition/browser.mjs",
    "test:bug:navigation-source": "node --test test/bug-condition/navigation-responsive.source.test.mjs",
    "test:bug:navigation-browser": "node test/bug-condition/navigation-responsive.browser.mjs",
    "test:bug:projects-source": "node --test test/bug-condition/projects-responsive.source.test.mjs",
    "test:bug:projects-property": "node --test --test-name-pattern=\"Property 1 keeps project content reachable\" test/bug-condition/property.test.mjs",
    "test:bug:projects-browser": "node test/bug-condition/projects-responsive.browser.mjs",
    "test:bug:build-evidence": "node test/bug-condition/capture-build-evidence.mjs",
    "test:preservation": "node test/preservation/run-all.mjs",
    "test:preservation:unit": "node --test test/preservation/unit.test.mjs",
    "test:preservation:property": "node --test test/preservation/property.test.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "leva": "^0.10.1",
    "lucide-react": "^1.29.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
